# Copie este arquivo para ".env" (sem o .example) e preencha.
# NUNCA suba o arquivo ".env" de verdade pro Git - ele já fica de fora
# automaticamente (veja o .gitignore).

# A URL que aparece na barra de endereço do navegador quando você está
# na tela onde clica em "S/4HANA - PRD (SSO)". Algo como:
# https://meuempresa.launchpad.cfapps.sap.hana.ondemand.com/...
# ou uma URL interna tipo https://sap-prd.suaempresa.com.br/sap/bc/ui2/flp
SAP_FIORI_URL=

# Qual navegador instalado no seu computador usar (assim ele reaproveita
# configurações/rede da empresa). Use "msedge", "chrome" ou deixe em
# branco para usar o Chromium que vem com o Playwright.
SAP_BROWSER_CHANNEL=msedge
