# Copie este arquivo para ".env" (sem o .example) e preencha com os
# dados que o time de TI/Basis te passar. NUNCA suba o arquivo ".env"
# de verdade pro Git - ele fica de fora automaticamente (veja .gitignore).

# URL base do sistema SAP, sem barra no final.
# Peça essa URL para a TI - normalmente é algo como:
# https://sap-prd.suaempresa.com.br:8443 (ou uma porta parecida)
SAP_BASE_URL=

# Mandante / client SAP (ex: 100). Pergunte à TI qual usar.
SAP_CLIENT=

# Usuário técnico (de serviço) criado pela TI/Basis para este programa.
# Não é o seu usuário de SSO do dia a dia.
SAP_USER=

SAP_PASSWORD=

# Deixe "true" (padrão). Só use "false" se a TI confirmar que o
# certificado é interno/autoassinado e por isso dá erro de SSL - nesse
# caso desligar a verificação é aceitável apenas em ambiente de teste.
SAP_VERIFY_SSL=true
